<Window x:Class="Partition2MuseScore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Partition2MuseScore"
        mc:Ignorable="d"
        Title="Partition2MuseScore" Height="380" Width="650" Icon="Resources/app.ico">
    <Grid>
    <Grid x:Name="MainContentGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Fichier source (PDF/image/.omr) :" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="InputPathTextBox" Margin="6,4" VerticalContentAlignment="Center" TextChanged="InputPathTextBox_TextChanged"/>
        <Button Grid.Row="0" Grid.Column="2" Content="Parcourir..." Padding="8,2" Click="BrowseInput_Click"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Fichier de sortie (.mscz) :" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="OutputPathTextBox" Margin="6,4" VerticalContentAlignment="Center"/>
        <Button Grid.Row="1" Grid.Column="2" Content="Parcourir..." Padding="8,2" Click="BrowseOutput_Click"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Langue de l'OCR (texte/paroles) :" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="OcrLanguageComboBox" Margin="6,4" HorizontalAlignment="Left" Width="220"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Options Audiveris :" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="KeepOmrCheckBox" Margin="6,4" VerticalAlignment="Center"
                   Content="Conserver le projet Audiveris (.omr) pour correction manuelle"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Style MuseScore (optionnel) :" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="StylePathTextBox" Margin="6,4" VerticalContentAlignment="Center"/>
        <Button Grid.Row="4" Grid.Column="2" Content="Parcourir..." Padding="8,2" Click="BrowseStyle_Click"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Versions détectées :" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Vertical" Margin="6,4" VerticalAlignment="Center">
            <!-- Glyphe spinner par outil (cf. MainWindow.xaml.cs StartGlyphSpinner) : masqué au
                 repos, affiché et animé pendant une installation/mise à jour winget en arrière-plan
                 (cf. ApplyToolActionsAsync), pour donner un retour visuel que ça avance vraiment
                 (auparavant, seul un texte statique "... en cours" l'indiquait). -->
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="AudiverisVersionText" Text="Audiveris : vérification..." FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="AudiverisSpinnerGlyph" Text="♪" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MuseScoreVersionText" Text="MuseScore : vérification..." FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="MuseScoreSpinnerGlyph" Text="♪" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
            <Button x:Name="ConvertButton" Content="Convertir la partition" Padding="10,4" Click="Convert_Click"/>
            <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                <!-- Image ne peut pas animer un GIF (seule la 1re image s'afficherait) ; un
                     glyphe dont le texte change en boucle (notes ↔ binaire, cf. MainWindow.xaml.cs
                     StartGlyphSpinner) donne le même effet "spinner", tout en illustrant la
                     conversion partition → binaire que fait l'appli. -->
                <TextBlock x:Name="SpinnerGlyph" Text="♪" FontSize="20" Width="32" TextAlignment="Center"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <ProgressBar x:Name="ConversionProgressBar" Minimum="0" Maximum="100" Width="240" Height="18"/>
                    <TextBlock x:Name="ConversionStatusText" Margin="0,4,0,0" FontSize="11"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="OpenFolderButton" Content="Ouvrir le dossier de destination" Padding="10,4" Margin="12,0,0,0" Visibility="Collapsed" Click="OpenFolder_Click"/>
        </StackPanel>
    </Grid>

    <!-- Écran de premier lancement : affiché tant qu'Audiveris et/ou MuseScore manquent et que
         leur installation winget est en cours (cf. MainWindow.xaml.cs/ShowFirstRunInstallScreenAsync).
         Masque le formulaire de conversion, inutilisable de toute façon sans ces outils. -->
    <Border x:Name="FirstRunOverlay" Background="#FFF6F6F6" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
            <TextBlock x:Name="FirstRunSpinnerGlyph" Text="♪" FontSize="56" Width="90"
                       TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="Installation des outils nécessaires" FontSize="15" FontWeight="Bold"
                       Margin="0,16,0,6" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="#FF555555"
                       Text="Audiveris et/ou MuseScore ne sont pas encore installés. Partition2MuseScore les installe automatiquement (via winget) — cette étape ne se produira plus une fois terminée."/>
            <TextBlock x:Name="FirstRunStatusText" FontSize="11" FontStyle="Italic" Margin="0,14,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
    </Border>
    </Grid>
</Window>
